TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
# Brevo transactional API key (starts xkeysib-). This is NOT the SMTP key.
BREVO_API_KEY=optional-brevo-api-key
# Must be on a sender address or domain authenticated in Brevo.
CONTACT_FROM_EMAIL=Byteflow Website <website@your-verified-domain.example>
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=optional-recaptcha-v3-site-key
RECAPTCHA_SECRET_KEY=optional-recaptcha-v3-secret-key
